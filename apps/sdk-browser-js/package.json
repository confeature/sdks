{
  "name": "@confeature/sdk-browser-js",
  "version": "0.1.0",
  "description": "Confeature Browser JS SDK — drop-in compatible with configcat-js.",
  "license": "MIT",
  "author": "MakerLabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/confeature/sdks.git",
    "directory": "apps/sdk-browser-js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:unit": "vp test --config vitest.unit.config.ts",
    "test:contract": "vp test --config vitest.contract.config.ts",
    "test:parity": "vp test --config vitest.parity.config.ts",
    "check": "vp check",
    "postbuild": "node ./scripts/check-bundle-size.mjs"
  },
  "devDependencies": {
    "@confeature/sdk-shared": "workspace:*",
    "@confeature/test-fixtures-sdk-parity": "workspace:*",
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "catalog:",
    "configcat-js": "^9.4.0",
    "happy-dom": "^15.11.7",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "confeature": {
    "owner": "sdk-browser-js"
  }
}
