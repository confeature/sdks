<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Confeature.OpenFeature</RootNamespace>
    <AssemblyName>Confeature.OpenFeature</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package metadata">
    <PackageId>Confeature.OpenFeature</PackageId>
    <Version>0.1.0</Version>
    <Authors>MakerLabs</Authors>
    <Company>MakerLabs</Company>
    <Description>OpenFeature provider for the Confeature .NET SDK.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/confeature/sdks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://confeature.io</PackageProjectUrl>
    <PackageTags>confeature;feature-flags;openfeature</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Confeature.Client/Confeature.Client.csproj" />
    <PackageReference Include="OpenFeature" Version="[2.14.1]" />
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
