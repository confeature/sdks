    "@nestjs/core": "11.2.11",
    "@openfeature/nestjs-sdk": "0.2.7",
    "@openfeature/server-sdk": "1.23.0",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
