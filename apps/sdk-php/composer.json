{
  "name": "confeature/confeature-php-sdk",
  "description": "Confeature PHP SDK. Drop-in compatible with configcat/configcat-php-sdk (Confeature Constitution Principle II).",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "MakerLabs"
    }
  ],
  "keywords": [
    "feature-flag",
    "feature-toggle",
    "configcat",
    "confeature",
    "configuration"
  ],
  "homepage": "https://confeature.io",
  "support": {
    "issues": "https://github.com/confeature/sdks/issues",
    "source": "https://github.com/confeature/sdks"
  },
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "configcat/configcat-client": "^9.2"
  },
  "autoload": {
    "psr-4": {
      "Confeature\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Confeature\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "php-cs-fixer fix --dry-run --diff",
    "lint:fix": "php-cs-fixer fix",
    "build": "@composer validate --strict && @composer dump-autoload --classmap-authoritative"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {},
    "platform": {
      "php": "8.1.0"
    }
  },
  "minimum-stability": "stable"
}
