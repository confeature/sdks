{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictMetadataEmit": true,
    "enableResourceInlining": true
  },
  "exclude": ["src/**/*.spec.ts", "tests/**/*"],
  "include": ["src/**/*.ts"]
}
