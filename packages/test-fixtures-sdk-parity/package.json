{
  "name": "@confeature/test-fixtures-sdk-parity",
  "version": "0.0.0",
  "private": true,
  "description": "Shared parity-test corpus for every Confeature SDK. (flag, user, expected) tuples + canonical config_v6 blobs. Pinned configcat-js as the parity reference.",
  "license": "MIT",
  "author": "MakerLabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/confeature/sdks.git",
    "directory": "packages/test-fixtures-sdk-parity"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./wire-test-helpers": {
      "types": "./src/wire-test-helpers.ts",
      "import": "./src/wire-test-helpers.ts"
    },
    "./fixtures/*.json": "./fixtures/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "vp check && tsx scripts/validate-wire-cases.ts",
    "export:corpus": "tsx scripts/export-corpus.ts",
    "export:cache-key-fixtures": "tsx scripts/export-cache-key-fixtures.ts",
    "check:exports": "tsx scripts/export-corpus.ts --check && tsx scripts/export-cache-key-fixtures.ts --check",
    "validate:wire-cases": "tsx scripts/validate-wire-cases.ts",
    "test": "vp test"
  },
  "dependencies": {},
  "devDependencies": {
    "@confeature/sdk-shared": "workspace:*",
    "@types/node": "^25.6.2",
    "ajv": "^8.17.1",
    "configcat-js": "^9.4.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "confeature": {
    "owner": "sdk-browser-js"
  }
}
